# Local-only credentials used by Docker Compose.
CLICKHOUSE_USER=flink
CLICKHOUSE_PASSWORD=flink
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin

# The learning schema and read-only Grafana account intentionally stay fixed
# as perfmon and observer/observer so SQL, dashboards, and exercises agree.

# Learning controls.
FLINK_PARALLELISM=4
OUT_OF_ORDER_SECONDS=10
WATERMARK_IDLE_SECONDS=30
# Flink operator JSON log threshold.
LOG_LEVEL=INFO
PRODUCER_STATS_INTERVAL_SECONDS=5
