# Generate local values with `make credentials`; never commit real passwords.
CLICKHOUSE_USER=flink
CLICKHOUSE_PASSWORD=
CLICKHOUSE_OBSERVER_USER=observer
CLICKHOUSE_OBSERVER_PASSWORD=
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=

# Learning controls.
FLINK_PARALLELISM=4
OUT_OF_ORDER_SECONDS=10
WATERMARK_IDLE_SECONDS=30
# Flink operator JSON log threshold.
LOG_LEVEL=INFO
PRODUCER_STATS_INTERVAL_SECONDS=5
